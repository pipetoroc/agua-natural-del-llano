---
import clouds from '../assets/clouds.webp'
import bottle from '../assets/bottle.webp'
---

<section class="grid bg-light">
  <img
    src={clouds.src}
    class="w-full h-auto timeline-view animate-fade-in-up animate-range-[entry_10%_contain_50%]"
    alt=""
  />
  <div class="grid md:grid-cols-2 -mt-20 max-w-7xl mx-auto">
    <div class="px-5 lg:pl-20 pb-20 flex flex-col items-center text-center">
      <h1
        class="pt-36 pb-12 text-secondary text-xl sm:text-3xl/relaxed font-bold max-w-[30ch] font-title uppercase lg:py-36">
        El água que bebes es vital para mantener la salud de tu cuerpo
      </h1>
      <button
        class="w-52 px-6 py-3 text-secondary border-2 rounded-4xl font-semibold"
        >Entre en contacto</button
      >
    </div>
    <figure
      class="w-full timeline-view animate-slide-in-bottom animate-range-[entry_10%_contain_20%] animate-slide-distance-[100%]">
      <img src={bottle.src} alt="Botellón de agua natural del llano" />
    </figure>
  </div>
</section>
