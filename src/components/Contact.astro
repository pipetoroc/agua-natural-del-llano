---
import ContactCard from './ContactCard.astro'
import ContactIcon from './icons/ContactIcon.astro'
import Input from './Input.astro'
import Location from './icons/Location.astro'
import Logo from './icons/Logo.astro'
import Message from './icons/Message.astro'
import Telephone from './icons/Telephone.astro'
import WhatsappIcon from './icons/WhatsappIcon.astro'
---

<section class="pt-40 pb-14 text-center bg-cream" id="contact">
  <div class="flex flex-col justify-center items-center">
    <div
      class="flex items-center justify-center size-20 p-4 mb-8 border-4 border-secondary rounded-full">
      <ContactIcon class="w-9 h-auto text-secondary stroke-2" />
    </div>
    <h1
      class="text-secondary font-title text-3xl/relaxed tracking-wide font-bold">
      Contacto
    </h1>
  </div>
  <p class="font-text text-2xl font-medium tracking-wide text-secondary/75">
    Ponte en contacto para pedidos, dudas o lo que necesites.
  </p>
  <div class="flex flex-wrap pt-16 gap-7">
    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="Post"
      class="flex flex-wrap items-center flex-1 pl-20 gap-4">
      <h2
        class="mb-8 w-full text-secondary font-text text-xl/relaxed tracking-wide font-semibold">
        Envíanos un mensaje
      </h2>
      <div class="flex flex-col flex-1 items-start gap-0.5">
        <input
          type="hidden"
          name="access_key"
          value="c34737be-f4bd-4a88-a560-7ddb8c777a95"
        />
        <Input
          class="flex flex-col"
          description="Nombre y apellido"
          name="full_name"
          title="Nombre y apellido"
          type="text"
          required
        />
      </div>

      <div class="flex flex-col flex-1 items-start gap-0.5">
        <Input
          description="Teléfono"
          name="phone"
          title="Teléfono"
          type="tel"
          required
        />
      </div>

      <div class="flex flex-col w-full items-start gap-0.5">
        <Input
          description="Dirección de correo electrónico"
          name="email"
          title="Correo electrónico"
          type="email"
          required
        />
      </div>

      <div class="flex flex-col w-full items-start gap-0.5">
        <label class="font-text" for="">Mensaje</label>
        <textarea
          class="w-full bg-white py-3 px-4 rounded-lg border border-secondary/20 text-dark/40"
          cols="30"
          rows="10"
          id=""
          name="message"
          placeholder="Déjanos tu mensaje"
          required></textarea>

        <button
          class="bg-secondary text-white py-3 px-6 rounded-3xl font-medium mt-2 cursor-pointer hover:bg-secondary/80 transition-colors duration-300"
          type="submit">Enviar mensaje</button
        >
      </div>
      <!-- Modal de éxito -->
      <div
        id="success-modal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-dark/60 backdrop-blur-sm px-4"
        role="dialog"
        aria-modal="true"
        aria-labelledby="success-title">
        <div
          class="w-full max-w-md rounded-2xl bg-cream p-8 shadow-2xl text-center">
          <!-- Icono -->
          <div
            class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-secondary/10">
            <svg
              class="h-8 w-8 text-secondary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>

          <!-- Contenido -->
          <h2
            id="success-title"
            class="mb-3 font-text text-2xl font-semibold text-dark">
            ¡Mensaje enviado!
          </h2>

          <p class="mb-7 leading-relaxed text-dark/60">
            Hemos recibido tu mensaje correctamente. Nos pondremos en contacto
            contigo lo antes posible.
          </p>

          <button
            id="close-modal"
            type="button"
            class="w-full rounded-3xl bg-secondary px-6 py-3 font-medium text-white transition-colors duration-300 hover:bg-secondary/80">
            Entendido
          </button>
        </div>
      </div>
    </form>

    <script>
      const form = document.querySelector('#contact-form')
      const modal = document.querySelector('#success-modal')
      const closeModalButton = document.querySelector('#close-modal')

      form?.addEventListener('submit', async (event) => {
        event.preventDefault()

        if (!form || !modal) return

        const submitButton = form.querySelector('button[type="submit"]')

        if (submitButton) {
          submitButton.disabled = true
          submitButton.textContent = 'Enviando...'
        }

        const formData = new FormData(form)

        try {
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData
          })

          const data = await response.json()

          if (data.success) {
            // Limpiar formulario
            form.reset()

            // Mostrar modal
            modal.classList.remove('hidden')
            modal.classList.add('flex')

            if (submitButton) {
              submitButton.disabled = false
              submitButton.textContent = 'Enviar mensaje'
            }
          } else {
            alert('No pudimos enviar el mensaje. Inténtalo nuevamente.')

            if (submitButton) {
              submitButton.disabled = false
              submitButton.textContent = 'Enviar mensaje'
            }
          }
        } catch (error) {
          alert('Ocurrió un error. Por favor, inténtalo nuevamente.')

          if (submitButton) {
            submitButton.disabled = false
            submitButton.textContent = 'Enviar mensaje'
          }
        }
      })

      closeModalButton?.addEventListener('click', () => {
        modal?.classList.remove('flex')
        modal?.classList.add('hidden')
      })

      // Cerrar haciendo click fuera de la tarjeta
      modal?.addEventListener('click', (event) => {
        if (event.target === modal) {
          modal.classList.remove('flex')
          modal.classList.add('hidden')
        }
      })

      // Cerrar con Escape
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          modal?.classList.remove('flex')
          modal?.classList.add('hidden')
        }
      })
    </script>

    <div class="flex-1 pr-20">
      <h2
        class="mb-8 w-full text-secondary font-text text-xl/relaxed tracking-wide font-semibold">
        ¿Qué funciona mejor para ti?
      </h2>
      <div class="flex flex-col py-8 px-6 bg-[#084991] gap-9 mt-3 rounded-2xl">
        <ContactCard
          title="Whatsapp"
          description="+57 320 962 9449"
          href="https://wa.me/573209629449">
          <WhatsappIcon
            class="w-5 text-secondary stroke-2 group-hover:text-cream"
          />
        </ContactCard>
        <ContactCard
          title="Teléfono"
          description="+57 320 962 9449"
          href="tel:+573209629449">
          <Telephone
            class="w-5 text-secondary stroke-2 group-hover:text-cream"
          />
        </ContactCard>
        <ContactCard
          title="Email"
          description="+57 320 962 9449"
          href="mailto:contacto@agua-natural-del-llano.com">
          <Message class="w-5 text-secondary stroke-2 group-hover:text-cream" />
        </ContactCard>

        <ContactCard
          class="flex-wrap"
          title="Ubicación"
          description="Calle 35 N.° 51-29, La Azotea, Villavicencio, Colombia">
          <Location
            class="w-5 text-secondary stroke-2 group-hover:text-cream"
          />
          <div class="grow" slot="extra">
            <iframe
              class="w-full h-48 rounded-lg border-0"
              loading="lazy"
              allowfullscreen
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3979.3925924451696!2d-73.65353698890519!3d4.142942246221748!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e3e2db89554c70f%3A0x8cc3d9ffe06ddf83!2sAgua%20natural%20del%20llano!5e0!3m2!1ses!2sco!4v1776296188384!5m2!1ses!2sco"
            ></iframe>
          </div>
        </ContactCard>
      </div>
    </div>
  </div>

  <div class="mt-20 w-full flex flex-col items-center justify-center gap-4">
    <Logo height="100" strokeColor="#084991" fillColor="#084991" />
    <h3
      class="text-title text-xl/snug font-normal tracking-wide text-secondary">
      Naturalmente Llanera
    </h3>
  </div>
</section>

<script>
  window.onload = function () {
    // Reset the form fields when the page loads
    document.getElementById('contact').reset()
  }
</script>
