---
import Picture from './Picture.astro'
import cup from '../assets/cup.webp'
import people from '../assets/people.webp'
import food from '../assets/food.webp'
---

<section class="bg-[#084991] pt-24">
  <div class="flex justify-between px-11 max-w-7xl mx-auto">
    <div>
      <h3 class="text-white-user font-title text-3xl font-semibold">
        Únete a nuestra comundidad
      </h3>
      <p
        class="pt-2.5 text-white-user font-text text-xl font-normal max-w-[40ch]">
        Síguenos en instagram para descubrir novedades y sentirte más cerca del
        Llano
      </p>
    </div>
    <div class="w-96 mt-4 border-t border-white"></div>
    <span class="text-white-user font-title text-2xl font-medium"
      >@del.llano.agua</span
    >
  </div>
  <div class="flex
    justify-center py-24 gap-8 flex-wrap">
    <Picture src={cup.src} alt="vaso con agua natural del Llano" />
    <Picture
      src={people.src}
      alt="Personas reunidas alrededor de un botellon de agua natural del Llano haciendo un brindis"
    />
    <Picture
      src={food.src}
      alt="Mesa con comida típica del Llano y un botellon de agua natural del Llano"
    />
  </div>
</section>
