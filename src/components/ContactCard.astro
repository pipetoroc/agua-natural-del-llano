---
const { title, description, href } = Astro.props
---

<a
  href={href}
  target="_blank"
  class:list={[
    'group flex flex-wrap p-6 bg-[#084991] rounded-2xl gap-4 shadow-lg cursor-pointer transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-lg',
    Astro.props.class
  ]}>
  <div class="flex items-start gap-4 w-full">
    <div
      class="flex shrink-0 justify-center size-14 items-center bg-cream p-4 rounded-xl transition-colors duration-300 ease-out group-hover:bg-badge">
      <slot />
    </div>

    <div class="flex flex-col items-start">
      <h2
        class="font-text text-lg/loose font-bold text-cream transition-colors duration-300 ease-out group-hover:text-badge">
        {title}
      </h2>

      <p class="font-text text-base/loose font-normal text-white-user">
        {description}
      </p>
    </div>
  </div>

  <div class="w-full">
    <slot name="extra" />
  </div>
</a>
